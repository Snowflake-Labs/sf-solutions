[project]
name = "{{REPO_NAME}}"
version = "0.1.0"
description = "Snowflake {{INDUSTRY_NAME}} Solution Accelerators"
requires-python = ">=3.11"
dependencies = []

[dependency-groups]
dev = [
    "ruff>=0.11.0",
    "sqruff>=0.38.0",
]

[tool.ruff]
line-length = 120
target-version = "py311"
# REPO_SPECIFIC_START: ruff-extend-exclude
extend-exclude = ["**/*.ipynb"]
# REPO_SPECIFIC_END: ruff-extend-exclude

[tool.ruff.lint]
select = ["E", "F", "W", "I", "D", "UP", "N"]
ignore = [
    "D100",  # Missing docstring in public module
    "D104",  # Missing docstring in public package
    "D107",  # Missing docstring in __init__
]

[tool.ruff.lint.pydocstyle]
convention = "google"
